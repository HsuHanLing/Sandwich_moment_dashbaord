# Copy to .env.local. Never commit credentials or ingest secrets.
# Explicit demonstration only; keep false in production.
MOMENT_DEMO=false
GOOGLE_CLOUD_PROJECT=sandwich-original
BIGQUERY_DATASET=analytics_474274728
BIGQUERY_TABLE=events_*
MOMENT_EVENTS_TABLE=sandwich-original.analytics_474274728.events_*
# REQUIRED: replace with the GA4 property's actual reporting timezone.
# Leaving blank visibly reports an assumed UTC timezone.
MOMENT_REPORT_TIME_ZONE=
GOOGLE_APPLICATION_CREDENTIALS=
DASHBOARD_PASSWORD=
# For hosted runtimes, GOOGLE_SERVICE_ACCOUNT can contain a service account JSON.
MOMENT_MAXIMUM_BYTES_BILLED=2000000000

# Create/review sql/analytics-schema.sql first, then enable each feed.
MOMENT_CONVERSATIONS_TABLE=
MOMENT_TRANSACTIONS_TABLE=
MOMENT_PRODUCTS_TABLE=
MOMENT_IDENTITIES_TABLE=
MOMENT_ROBOT_ALIASES_TABLE=
MOMENT_REVENUECAT_INBOX_TABLE=

# Advance these watermarks only after complete, reconciled imports. Missing or
# out-of-range watermarks hide financial/conversation figures rather than show 0.
MOMENT_CONVERSATIONS_COMPLETE_FROM=
MOMENT_CONVERSATIONS_COMPLETE_THROUGH=
MOMENT_TRANSACTIONS_COMPLETE_FROM=
MOMENT_TRANSACTIONS_COMPLETE_THROUGH=
MOMENT_VERIFIED_EVENTS_COMPLETE_FROM=
MOMENT_VERIFIED_EVENTS_COMPLETE_THROUGH=
MOMENT_VERIFIED_EVENTS=

# Server-to-server only. Configure different random secrets for the two feeds.
MOMENT_INGEST_SECRET=
MOMENT_INGEST_URL=http://127.0.0.1:3020/api/moment/ingest
REVENUECAT_WEBHOOK_SECRET=
MOMENT_REVENUECAT_APP_ID=
